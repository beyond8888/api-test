# 复制本文件为 .env 后按实际环境填写，.env 不要提交到版本库

# Django 安全密钥，生产环境必须设置为强随机字符串
SECRET_KEY=your-secure-random-secret-key-here

# 开发环境可设为 True，生产环境必须为 False
DEBUG=False

# 允许访问的主机，多个用逗号分隔
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1

# CORS 白名单，前端地址
CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173

# 是否允许 Proxy 访问私有/回环地址（本地开发可设为 1，生产必须设为 0）
API_PROXY_ALLOW_PRIVATE=0

# 是否启用 SSL 重定向（生产环境保持 1）
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
