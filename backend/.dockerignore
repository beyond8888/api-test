# ─── Backend .dockerignore ─────────────────
# Reduces build context size by excluding unnecessary files

# Virtual env (will be installed fresh in image)
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.so
.Python

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Django
db.sqlite3
db.sqlite3-journal
/media/
/static/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store

# Data volumes
data/

# Git
.git/
.gitignore

# Docker
Dockerfile
.dockerignore

# Docs
*.md

# Secrets / environment (must never enter the image)
.env
.env.local
.env.*.local
secrets*.json
*.key
*.pem
